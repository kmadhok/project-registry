{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/data/build/lease.json\" ] || [ -f \"$CLAUDE_PROJECT_DIR/scripts/build-guard.py\" ]; then python3 \"$CLAUDE_PROJECT_DIR\"/scripts/build-guard.py; fi",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/data/build/lease.json\" ] || [ -f \"$CLAUDE_PROJECT_DIR/scripts/build-guard.py\" ]; then python3 \"$CLAUDE_PROJECT_DIR\"/scripts/build-guard.py; fi",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "mcp__project-registry__.*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/data/build/lease.json\" ] || [ -f \"$CLAUDE_PROJECT_DIR/scripts/build-guard.py\" ]; then python3 \"$CLAUDE_PROJECT_DIR\"/scripts/build-guard.py; fi",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
