{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kmadhok/project-registry/registry/schema/project.schema.json",
  "title": "Registry project",
  "description": "One curated project. Human intent only -- observed GitHub state lives in data/github/snapshot.json and is never merged into this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stable slug. Relationships reference this."
    },
    "name": { "type": "string", "minLength": 1 },
    "purpose": {
      "type": "string",
      "description": "Why this project exists. Required unless needs_review is true."
    },
    "desired_outcome": {
      "type": "string",
      "description": "The result that matters. Required for lifecycle `now`."
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "description": "Owner-curated intent and the criteria that make a project ready to build.",
      "properties": {
        "done_criteria": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Observable outcomes that define completion. At least one is required for build or shadow automation."
        },
        "non_goals": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Work explicitly outside this project's intended scope."
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Owner-defined boundaries the implementation must respect."
        },
        "open_decisions": {
          "type": "array",
          "default": [],
          "description": "Intent questions that remain open or have been explicitly answered.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question"],
            "properties": {
              "question": { "type": "string", "minLength": 1 },
              "status": { "enum": ["open", "answered"], "default": "open" },
              "answer": { "type": ["string", "null"], "default": null }
            }
          }
        },
        "reviewed": {
          "type": ["string", "null"],
          "format": "date",
          "description": "Date the owner last confirmed that this brief is current."
        }
      }
    },
    "lifecycle": {
      "enum": ["now", "next", "incubating", "showcase", "maintained", "reference", "superseded", "archived"],
      "default": "incubating"
    },
    "active": {
      "type": "boolean",
      "default": false,
      "description": "Separate from lifecycle so exceptions can be expressed."
    },
    "needs_review": { "type": "boolean", "default": false },
    "category": { "type": "string" },
    "priority": {
      "enum": ["high", "medium", "low"],
      "description": "Human priority. Never derived from GitHub activity."
    },
    "effort": { "enum": ["small", "medium", "large"] },
    "horizon": { "enum": ["week", "month", "quarter", "year", "someday"] },
    "blocked_by": { "type": "string" },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Owner-controlled policy for autonomous project work.",
      "properties": {
        "mode": {
          "enum": ["off", "shadow", "spec_only", "build"],
          "default": "off",
          "description": "Maximum automation level permitted for this project."
        },
        "allow": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["dependencies", "ci", "generated_data", "public_api", "migrations", "personal_data"]
          },
          "default": [],
          "description": "Change classes the owner permits automation to make."
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-run limits for autonomous work.",
          "properties": {
            "chunks_per_run": {
              "type": "integer",
              "minimum": 1,
              "default": 6,
              "description": "Maximum work chunks attempted in one run."
            },
            "minutes_per_run": {
              "type": "integer",
              "minimum": 1,
              "default": 120,
              "description": "Maximum elapsed minutes permitted in one run."
            }
          }
        },
        "paused": {
          "type": "boolean",
          "default": false,
          "description": "Owner kill switch that prevents new automated work from starting."
        }
      }
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$",
      "description": "owner/name. Omit for intentional non-repository projects."
    },
    "is_fork": { "type": "boolean", "default": false },
    "visibility": { "enum": ["public", "private"], "default": "private" },
    "last_reviewed": { "type": "string", "format": "date" },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "description": "At most one. Required when active is true.",
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "reviewed": { "type": "string", "format": "date" },
        "link": { "type": "string" }
      }
    },
    "accomplishments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "summary"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "summary": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["milestone", "artifact", "demo", "lesson", "release"],
            "default": "milestone"
          },
          "links": { "type": "array", "items": { "type": "string" } },
          "public": {
            "type": "boolean",
            "default": false,
            "description": "Explicit opt-in before this appears in a public export."
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "target"],
        "properties": {
          "kind": {
            "enum": ["successor", "predecessor", "duplicate", "component", "part_of", "related"]
          },
          "target": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "note": { "type": "string" }
        }
      }
    },
    "descriptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "private": { "type": "string" },
        "public_safe": {
          "type": "string",
          "description": "The only description a public export may use."
        }
      }
    },
    "public": {
      "type": "boolean",
      "default": false,
      "description": "Opt in to the portfolio export. Requires descriptions.public_safe."
    },
    "showcase_order": { "type": "integer" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}
