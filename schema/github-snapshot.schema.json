{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kmadhok/project-registry/schema/github-snapshot.schema.json",
  "title": "GitHub Snapshot",
  "type": "object",
  "required": ["schema_version", "owner", "generated_at", "repositories", "open_pull_requests", "open_issues", "errors"],
  "properties": {
    "schema_version": {"const": 1},
    "owner": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "repositories": {"type": "array", "items": {"type": "object"}},
    "open_pull_requests": {"type": "array", "items": {"type": "object"}},
    "open_issues": {"type": "array", "items": {"type": "object"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
